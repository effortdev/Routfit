# docker-compose가 참조하는 환경변수 (실제 값은 .env 파일에 작성하고 git에 커밋하지 말 것)
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=roufit
DB_USERNAME=roufit
DB_PASSWORD=change-me-db-password

JWT_SECRET=change-this-to-a-random-32-plus-char-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 프론트 빌드 시 주입될 백엔드 API 주소 (NPM에 등록할 도메인)
VITE_API_BASE_URL=https://roufit-api.effortdev.duckdns.org
